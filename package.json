{
  "name": "c2mtools",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "presubmit": "npm run typecheck && npm run fmt:check && npm test && npm run build:web",
    "test": "vitest run",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "generate:procedural-level": "tsc -p tsconfig.json && node dist/procedural_generation/generateLevel.js",
    "generate:islide": "tsc -p tsconfig.json && node dist/procedural_generation/generateISlide.js",
    "test:watch": "vitest",
    "prepare": "husky",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "fmt:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "CC-BY-4.0",
  "type": "module",
  "dependencies": {
    "@fontsource/micro-5": "^5.2.7",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/silkscreen": "^5.2.8",
    "@fontsource/tiny5": "^5.2.7",
    "@noble/hashes": "2.3.0",
    "@notcc/logic": "1.1.7",
    "buffer": "^6.0.3",
    "commander": "^14.0.2",
    "dattools": "git+https://github.com/joshua-bone/DATTools.git#6fe85c0",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "bin": {
    "c2mtools": "dist/cli.js"
  }
}
